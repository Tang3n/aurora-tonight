{
  "name": "aurora-tonight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode app && vite build -c vite.runner.config.ts",
    "android:sync": "npm run build:app && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.6.2",
    "d3-geo": "^3.1.1",
    "suncalc": "^1.9.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/suncalc": "^1.9.2",
    "@types/topojson-client": "^3.1.5",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
