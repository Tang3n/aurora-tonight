{
  "name": "aurora-tonight",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aurora/web",
    "build": "npm run build -w @aurora/web",
